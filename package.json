{
  "name": "amazon-clone-full",
  "version": "1.0.0",
  "description": "Amazon clone project using Vue.js, Nuxt.js, MongoDb, Stripe, Algolia, and AWS",
  "author": "kathirr007",
  "private": true,
  "toDebug": "Add --inspect=7000 --inspect-brk before javascript file to debug node server functions",
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon server/server.js --watch server",
    "build": "nuxt build",
    "analyze": "nuxt build -a",
    "start": "cross-env NODE_ENV=production node server/server.js",
    "generate": "nuxt generate",
    "test": "PORT=8000 nuxt",
    "vercel-build-old": "yarn global add node-gyp node-pre-gyp node-gyp-build"
  },
  "dependencies": {
    "@nuxtjs/auth": "^4.9.1",
    "@nuxtjs/axios": "^5.13.6",
    "@nuxtjs/dotenv": "^1.4.2",
    "@nuxtjs/pwa": "^3.3.5",
    "algoliasearch": "^5.35.0",
    "aws-sdk": "^2.1692.0",
    "axios": "^1.11.0",
    "bcryptjs": "^3.0.2",
    "body-parser": "^2.2.0",
    "bootstrap": "^5.3.7",
    "bootstrap-vue": "^2.23.1",
    "cors": "^2.8.5",
    "cross-env": "^10.0.0",
    "date-fns": "^4.1.0",
    "express": "^5.1.0",
    "mongoose": "^8.17.1",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "multer-s3": "^3.0.1",
    "node-fetch": "^3.3.2",
    "nuxt": "^4.0.3",
    "nuxt3-vuex-module": "^1.1.2",
    "stripe": "^18.4.0",
    "vue-carousel": "^0.18.0"
  },
  "devDependencies": {
    "dotenv": "^17.2.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose-algolia": "^1.10.1",
    "mongoose-deep-populate": "^3.2.0",
    "node-fetch-native": "^1.6.7",
    "nodemon": "^3.1.10",
    "sass": "^1.90.0",
    "sass-loader": "16.0.5",
    "vue-star-rating": "^1.7.0",
    "vuex-persistedstate": "^4.1.0"
  },
  "resolutions": {}
}
